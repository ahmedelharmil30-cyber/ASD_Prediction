# Copy this file to .env and adjust values as needed
APP_NAME="ASD Prediction Platform API"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CORS - comma separated list of allowed origins.
# http://localhost:3000 is the Next.js dev server (frontend/).
# Add your deployed frontend URL(s) here too, e.g. your Streamlit Cloud app:
# https://ahmedelharmil30-cyber-asd-predict-streamlit-frontendhome-vfjinb.streamlit.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trained model filenames, resolved inside MODELS_DIR
DEFAULT_MODEL_FILE=asd_best_model.joblib
METADATA_FILE=asd_model_metadata.joblib

# Optional: override the models directory.
# Leave blank to default to <project_root>/models (i.e. ASD_Prediction/models/) —
# that's correct for local dev, where backend/ sits next to the top-level models/.
# On Railway, only the backend/ folder is deployed (Root Directory = backend), so
# ASD_Prediction/models/ does not exist there. This repo now ships a copy of the
# joblib files at backend/models/ for that case — set MODELS_DIR=models on Railway
# (as a dashboard env var, NOT in this file) so it resolves to backend/models/.
MODELS_DIR=
